# WAF NovaPay — nginx + ModSecurity + OWASP CRS.
server {
    listen 8080;
    server_name _;
    modsecurity on;

    # Mitigations dynamiques déposées par le remediation-engine (ex. limitation
    # de débit en cas de DDoS). Le glob n'échoue pas s'il n'y a aucun fichier :
    # dossier vide = aucune mitigation active.
    include /etc/nginx/dynamic/*.inc;

    location /api/  { proxy_pass http://payment-api:8080/; }
    location /auth/ { proxy_pass http://auth-service:8080/; }
    location /      { proxy_pass http://web:80; }
}
