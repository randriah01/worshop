server {
    listen 8080 default_server;
    server_name _;
    location /health {
        proxy_pass http://payment-api:8080/health;
        proxy_set_header Host $host;
    }
    location /api/ {
        proxy_pass http://payment-api:8080/;
        proxy_set_header Host $host;
    }
    location /auth/ {
        proxy_pass http://auth-service:8080/;
        proxy_set_header Host $host;
    }
    location / {
        proxy_pass http://web:80/;
        proxy_set_header Host $host;
    }
}
