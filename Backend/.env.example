# Copie ce fichier en .env et adapte les valeurs.
# NE COMMITE JAMAIS le vrai .env — les vrais secrets passent par Vault ou SOPS.

DB_NAME=novapay
DB_USER=novapay
DB_PASSWORD=changeme-in-vault

# Doit être IDENTIQUE pour payment-api et auth-service (vérification des JWT).
JWT_SECRET=dev-secret-a-remplacer

# Jeton interne : seuls la détection et la remédiation déposent un incident.
INTERNAL_TOKEN=internal-dev-token

# Compte administrateur créé au démarrage de l'auth-service.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin1234

GRAFANA_PASSWORD=admin
